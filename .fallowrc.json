{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "design/**",
    "frontend/dist/**"
  ],
  "entry": [
    "frontend/src/main.tsx",
    "frontend/public/push-sw.js"
  ],
  "duplicates": {
    // Fallow's recommended default: report copy-paste in 3+ places. The
    // worthwhile pair-clones (calendar lane-packing, the admin-groups effect)
    // were extracted into shared helpers; the rest are sub-10-line boilerplate
    // pairs not worth a shared abstraction.
    "minOccurrences": 3
  },
  "rules": {}
}
