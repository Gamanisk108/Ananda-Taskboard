# Copy to backend/.env (gitignored) and fill in for production. Dev has safe defaults.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# DB: leave unset for SQLite; set to switch to Postgres (no code change).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=https://your-frontend.example,http://localhost:5173

# Business timezone + daily push time (local to APP_TIMEZONE)
APP_TIMEZONE=America/Los_Angeles
DAILY_PUSH_HOUR=8
DAILY_PUSH_MINUTE=0

# Web Push (VAPID) — generate a keypair (see docs/deploy-runbook.md)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Shared secret the GitHub Actions cron presents to /api/jobs/daily-push
DAILY_PUSH_SECRET=change-me-long-random
