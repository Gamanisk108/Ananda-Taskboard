# Python / Django
__pycache__/
*.py[cod]
venv/
.venv/
*.sqlite3
db.sqlite3
.env
*.log
# collectstatic output — regenerated by the Render build (`collectstatic --noinput`)
# and served at runtime by WhiteNoise. Never needs to be committed.
backend/staticfiles/

# Node / Vite
node_modules/
dist-ssr/
*.local
.vite/
# NOTE: frontend/dist IS tracked on purpose so the cloud deploy (Python-only
# Render image) doesn't need Node to build. Re-commit it after frontend changes.

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# QA screenshots (regenerated by qa/webapp_smoke.py)
qa/shots/

# Secrets / keys
*.pem
vapid_*.json
.env.*
!.env.example
.fallow/

# Claude Code local workspace + MCP/QA tool scratch (ad-hoc, regenerated)
.claude/
.playwright-mcp/
/qa-*.png
# Sentry DSN is a publishable client key - this one .env file IS committed
!frontend/.env.production

# QA video recordings (QA_RECORD=1) — regenerable, never committed
frontend/qa/videos/
